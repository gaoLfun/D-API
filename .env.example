# Generate with: openssl rand -base64 32
DAPI_MASTER_KEY=

# Use long, independent values. The administrator password must be 12+ characters.
POSTGRES_PASSWORD=
DAPI_ADMIN_USERNAME=admin
DAPI_ADMIN_PASSWORD=
DAPI_SESSION_TTL=24h

# Set a DNS name for automatic public HTTPS, or leave localhost for local use.
DAPI_DOMAIN=localhost

# Optional direct port. Keep loopback when using Caddy; direct public access is HTTP only.
DAPI_BIND=127.0.0.1:18083
DAPI_TRUST_PROXY=true
