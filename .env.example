# Copy this file to .env. Never commit the populated .env file.
# Generate with: openssl rand -base64 32
DAPI_MASTER_KEY=

# Optional full PostgreSQL URL. Leave blank to use the Compose split settings.
# DAPI_DATABASE_URL=postgres://dapi:password@db.example:5432/dapi?sslmode=require

# Use long, independent values. The administrator password must be 12+ characters.
POSTGRES_PASSWORD=
DAPI_ADMIN_USERNAME=admin
DAPI_ADMIN_PASSWORD=
DAPI_SESSION_TTL=24h
DAPI_HEALTH_INTERVAL=30s
DAPI_BALANCE_INTERVAL=10m
DAPI_LOG_RETENTION=720h

# Set a DNS name for automatic public HTTPS, or leave localhost for local use.
DAPI_DOMAIN=localhost

# Optional direct port. Keep loopback when using Caddy; direct public access is HTTP only.
DAPI_BIND=127.0.0.1:18083
# Only enable when D-API is behind a trusted reverse proxy (for example Caddy).
DAPI_TRUST_PROXY=false
DAPI_MAX_CONCURRENT_REQUESTS=256
DAPI_MAX_CONCURRENT_PER_KEY=32
DAPI_MAX_REQUESTS_PER_MINUTE=600
DAPI_MAX_REQUEST_DURATION=15m
